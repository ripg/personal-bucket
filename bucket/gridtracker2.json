{
    "version": "2.261108.4",
    "description": "Amateur radio grid mapping and logging companion for WSJT-X and JTDX.",
    "homepage": "https://gridtracker.org/",
    "license": "BSD-3-Clause",
    "url": "https://download2.gridtracker.org/GridTracker2-2.261108.4-setup.exe#/dl.7z",
    "hash": "5af4f89c94ac7563d61c84c66b95b13ff763513f52d8d7c5986234ef9ae0eac6",
    "architecture": {
        "64bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        },
        "32bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-32.7z\" \"$dir\""
        }
    },
    "post_install": [
        "Get-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\" -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force"
    ],
    "shortcuts": [
        [
            "launch.cmd",
            "GridTracker2",
            "",
            "GridTracker2.exe"
        ]
    ],
    "checkver": {
        "url": "https://gridtracker.org/index.php/downloads/gridtracker-downloads",
        "regex": "https://download2\\.gridtracker\\.org/GridTracker2-([\\d.]+)-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://download2.gridtracker.org/GridTracker2-$version-setup.exe#/dl.7z"
    },
    "persist": "data",
    "notes": [
        "Use the Scoop shortcut to direct Electron user data, browser cache and temporary files to persist."
    ],
    "installer": {
        "script": [
            "@(",
            "    '@echo off'",
            "    'setlocal DisableDelayedExpansion'",
            "    'set \"APP_PERSIST=%~dp0data\"'",
            "    'set \"TEMP=%APP_PERSIST%\\temp\"'",
            "    'set \"TMP=%TEMP%\"'",
            "    'if not exist \"%TEMP%\\\" mkdir \"%TEMP%\" || exit /b 1'",
            "    'if not exist \"%APP_PERSIST%\\profile\\\" mkdir \"%APP_PERSIST%\\profile\" || exit /b 1'",
            "    'start \"\" /D \"%~dp0.\" \"%~dp0GridTracker2.exe\" --user-data-dir=\"%APP_PERSIST%\\profile\" --disk-cache-dir=\"%APP_PERSIST%\\cache\" --disable-auto-updates %*'",
            ") | Set-Content -LiteralPath (Join-Path $dir 'launch.cmd') -Encoding Ascii"
        ]
    }
}
