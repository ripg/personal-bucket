{
    "version": "3.37",
    "description": "Amateur radio application for FT8 and other digital modes.",
    "homepage": "https://qft8.com/zh/",
    "license": "Freeware",
    "checkver": {
        "url": "https://qft8.com/zh/",
        "regex": "qFT8-v([\\d.]+)-windows-64bits\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://github.com/lquesada/qFT8/releases/download/main/qFT8-v$version-windows-32bits.zip"
            },
            "64bit": {
                "url": "https://github.com/lquesada/qFT8/releases/download/main/qFT8-v$version-windows-64bits.zip"
            }
        }
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/lquesada/qFT8/releases/download/main/qFT8-v3.37-windows-64bits.zip",
            "hash": "6f984c76e5319df51e8cbd1fe4c55d741e964460f77264c0bffc48c6105f2c32",
            "extract_dir": "qFT8"
        },
        "32bit": {
            "url": "https://github.com/lquesada/qFT8/releases/download/main/qFT8-v3.37-windows-32bits.zip",
            "hash": "20459a2c56345c304010a2b50fb279fd7a09e4e6012bb25dd61c975b2b66b9ed",
            "extract_dir": "qFT8"
        }
    },
    "persist": "data",
    "shortcuts": [
        [
            "launch.cmd",
            "qFT8",
            "",
            "qFT8.exe"
        ]
    ],
    "notes": [
        "Use the Scoop shortcut to store the qFT8 profile and temporary files under persist.",
        "qFT8 can save SSTV and other images in Windows Pictures. Choose locations under persist when exporting files."
    ],
    "installer": {
        "script": [
            "@(",
            "    '@echo off'",
            "    'setlocal DisableDelayedExpansion'",
            "    'set \"APP_PERSIST=%~dp0data\"'",
            "    'set \"TEMP=%APP_PERSIST%\\temp\"'",
            "    'set \"TMP=%TEMP%\"'",
            "    'if not exist \"%TEMP%\\\" mkdir \"%TEMP%\" || exit /b 1'",
            "    'if not exist \"%APP_PERSIST%\\profile\\\" mkdir \"%APP_PERSIST%\\profile\" || exit /b 1'",
            "    'start \"\" /D \"%~dp0.\" \"%~dp0qFT8.exe\" --qft8_profile \"%APP_PERSIST%\\profile\" %*'",
            ") | Set-Content -LiteralPath (Join-Path $dir 'launch.cmd') -Encoding Ascii"
        ]
    }
}
