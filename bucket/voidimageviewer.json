{
    "version": "1.0.0.15",
    "description": "A lightweight image viewer for Windows.",
    "homepage": "https://github.com/voidtools/voidImageViewer",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/voidtools/voidImageViewer/releases/download/1.0.0.15/voidImageViewer-1.0.0.15.x64.en-US.zip",
            "hash": "bbffe4f9b292c264a3e7655727b57c692af4e69848d68d7ff05e3eb887967d80"
        },
        "32bit": {
            "url": "https://github.com/voidtools/voidImageViewer/releases/download/1.0.0.15/voidImageViewer-1.0.0.15.x86.en-US.zip",
            "hash": "c87f7cd5d11dfcb6ecdee4345f5aa6f6b74ae2b49a554510b221ce846ec5f679"
        },
        "arm64": {
            "url": "https://github.com/voidtools/voidImageViewer/releases/download/1.0.0.15/voidImageViewer-1.0.0.15.ARM64.en-US.zip",
            "hash": "1982d022b46465bb8e0514d2f1b05eb9edc664c1f7d412aeb61ea8c634ec6ef6"
        }
    },
    "persist": "data",
    "installer": {
        "script": [
            "if (Test-Path -LiteralPath (Join-Path $dir 'voidImageViewerARM64.exe')) {",
            "    Rename-Item -LiteralPath (Join-Path $dir 'voidImageViewerARM64.exe') -NewName 'voidImageViewer.exe' -ErrorAction Stop",
            "}",
            "@(",
            "    '@echo off'",
            "    'setlocal DisableDelayedExpansion'",
            "    'set \"source=%~dp0voidImageViewer.exe\"'",
            "    'set \"viewer=%~dp0data\\voidImageViewer.exe\"'",
            "    'if not exist \"%~dp0data\\.\" mkdir \"%~dp0data\" || exit /b 1'",
            "    'fc.exe /b \"%source%\" \"%viewer%\" >nul 2>&1'",
            "    'if errorlevel 1 copy /y \"%source%\" \"%viewer%\" >nul || exit /b 1'",
            "    'start \"\" \"%viewer%\" %*'",
            ") | Set-Content -LiteralPath (Join-Path $dir 'launch.cmd') -Encoding Ascii -ErrorAction Stop"
        ]
    },
    "shortcuts": [
        [
            "launch.cmd",
            "voidImageViewer",
            "",
            "voidImageViewer.exe"
        ]
    ],
    "bin": [
        [
            "launch.cmd",
            "voidimageviewer"
        ]
    ],
    "notes": "Launch from the Scoop shortcut or use the voidimageviewer command to keep settings under persist.",
    "checkver": {
        "github": "https://github.com/voidtools/voidImageViewer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/voidtools/voidImageViewer/releases/download/$version/voidImageViewer-$version.x64.en-US.zip"
            },
            "32bit": {
                "url": "https://github.com/voidtools/voidImageViewer/releases/download/$version/voidImageViewer-$version.x86.en-US.zip"
            },
            "arm64": {
                "url": "https://github.com/voidtools/voidImageViewer/releases/download/$version/voidImageViewer-$version.ARM64.en-US.zip"
            }
        }
    }
}
